---
import Brandmark from "./Brandmark.astro";
const year = new Date().getFullYear();

// ⬇️ PEGA AQUÍ TU LINK DE CALENDLY (el del evento de 15 min).
//    Conecta tu Google/Outlook una vez en calendly.com → ahí vive el sync real.
//    Ejemplo: "https://calendly.com/emilia-unlimitedcode/15min"
const CALENDLY_USER_URL = "https://calendly.com/julia-healthcare/emilia-agenda";

// Tema del embed (oscuro, acento naranja de marca). No tocar salvo el color.
const CALENDLY_URL =
  CALENDLY_USER_URL +
  "?hide_gdpr_banner=1&background_color=121012&text_color=ffffff&primary_color=ff5a00";
---
<section class="cta on-abyss" id="contacto">
  <div class="container cta__grid">
    <div class="cta__left">
      <a class="cta__logo" href="#top" aria-label="Unlimited Code — inicio"><Brandmark tone="light" /></a>
      <h2 class="display-1 cta__title">Checa si Unlimited Code es para ti <span class="serif">(claro que sí lo es)</span></h2>
      <p class="lead cta__sub">Agenda una llamada de 15 minutos. Elige el día y la hora que te queden — sin presión, sin discurso de ventas.</p>
    </div>

    <div class="cal-embed reveal" data-delay="1">
      <div class="calendly-inline-widget" data-url={CALENDLY_URL}></div>
      <noscript>
        <a class="cal-embed__fallback" href={CALENDLY_USER_URL} target="_blank" rel="noopener">Agenda tu llamada en Calendly →</a>
      </noscript>
    </div>
  </div>

  <footer class="foot">
    <div class="container foot__inner">
      <p class="foot__loc">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11Z"/><circle cx="12" cy="10" r="2.5"/></svg>
        Con sede en Ciudad de México
      </p>
      <p class="foot__legal">
        © {year} Unlimited Code
        <span class="foot__sep" aria-hidden="true">·</span>
        <a class="foot__link" href="/terminos">Términos y condiciones</a>
      </p>
    </div>
  </footer>
</section>

<script is:inline async src="https://assets.calendly.com/assets/external/widget.js"></script>

<style>
  .cta { background: var(--abyss); color: #fff; padding-top: clamp(4rem, 9vh, 7rem); }
  .cta__grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .cta__logo { display: inline-flex; margin-bottom: 1.5rem; }
  .cta__title { color: #fff; max-width: 14ch; font-size: clamp(2.4rem, 1.6rem + 3vw, 3.6rem); line-height: 1; letter-spacing: -0.035em; text-wrap: balance; }
  .cta__title .serif { color: #fff; }
  .cta__sub { color: var(--on-abyss-soft); margin-top: 1.4rem; max-width: 42ch; }

  /* Calendly embed — themed to the dark section; day + time + sync handled by Calendly */
  .cal-embed {
    border: 1px solid var(--line-abyss); border-radius: var(--r-card-lg);
    overflow: hidden; background: var(--abyss-2);
    box-shadow: 0 30px 70px -30px rgba(0,0,0,0.7);
  }
  .calendly-inline-widget { min-width: 280px; height: 680px; width: 100%; }
  .cal-embed__fallback { display: inline-block; padding: 1.5rem; color: #fff; font-weight: 700; }

  /* Footer bar */
  .foot { margin-top: clamp(4rem, 9vh, 7rem); border-top: 1px solid var(--line-abyss); padding-block: 2rem; }
  .foot__inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem 1.5rem; }
  .foot__loc { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--on-abyss-soft); font-weight: 500; font-size: 0.95rem; }
  .foot__legal { color: var(--on-abyss-soft); font-size: 0.9rem; font-weight: 500; }
  .foot__sep { margin-inline: 0.5rem; opacity: 0.6; }
  .foot__link { color: var(--on-abyss-soft); text-decoration: underline; text-underline-offset: 2px; text-decoration-color: var(--line-abyss); }
  .foot__link:hover { color: #fff; }

  @media (max-width: 860px) {
    .cta__grid { grid-template-columns: 1fr; }
    .cal-embed { max-width: 480px; }
  }
  @media (max-width: 600px) {
    .foot__inner { flex-direction: column; align-items: flex-start; }
  }
</style>
