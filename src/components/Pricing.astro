---
const features = [
  "Una solicitud a la vez",
  "Entrega promedio en 48h",
  "Desarrollo, automatización e IA",
  "El código es 100% tuyo",
  "Mantenimiento activo",
  "Hasta 2 usuarios",
  "Pausa o cancela cuando quieras",
];
---
<section class="pr section section--air" id="precios">
  <div class="container">
    <header class="pr__head">
      <p class="pr__eyebrow"><span class="pr__eyebrow-dot"></span>Empieza hoy · Únete a Unlimited Code</p>
      <h2 class="display-2">Una suscripción,<br /><span class="serif">posibilidades infinitas</span></h2>
    </header>

    <div class="pr__cards">
      <!-- White join card -->
      <article class="pr__join reveal" data-delay="1">
        <span class="pr__pill"><span class="pr__pill-dot"></span>Empieza hoy</span>
        <span class="pr__joinmark" aria-hidden="true">
          <svg viewBox="0 0 80 80" fill="none"><rect x="2" y="2" width="76" height="76" rx="22" fill="var(--ink)"/><circle cx="30" cy="34" r="3.4" fill="#fff"/><circle cx="50" cy="34" r="3.4" fill="#fff"/><path d="M26 48c3.6 4.8 8.4 7 14 7s10.4-2.2 14-7" stroke="#fff" stroke-width="4.6" stroke-linecap="round"/></svg>
        </span>
        <div class="pr__joinfoot">
          <h3 class="pr__join-title">Únete a<br />Unlimited Code</h3>
          <p class="pr__join-sub">Una suscripción, todo el desarrollo que necesites. Sin contratos, sin sorpresas.</p>
        </div>
      </article>

      <!-- Dark price card -->
      <article class="pr__plan on-abyss reveal" data-delay="2">
        <div class="pr__planhead">
          <span class="pr__planname">Club Mensual</span>
          <span class="pr__badge">Descuento de por vida</span>
        </div>
        <div class="pr__pricerow">
          <span class="pr__price">$24,995</span>
          <div class="pr__unit"><s class="pr__old">$34,995</s><span class="pr__per">MXN / mes</span></div>
        </div>
        <span class="pr__inc">INCLUIDO</span>
        <ul class="pr__features">
          {features.map((f) => (<li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5 9.5 18 20 6.5"/></svg>{f}</li>))}
        </ul>
        <a class="pr__cta" href="#contacto">
          <span class="pr__cta-ic"><svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="14.5" cy="16" r="1.4" fill="currentColor" stroke="none"/><circle cx="25.5" cy="16" r="1.4" fill="currentColor" stroke="none"/><path d="M13 24c2 2.6 4.4 4 7 4s5-1.4 7-4"/></svg></span>
          Únete hoy
        </a>
        <span class="pr__smiley" aria-hidden="true">
          <svg viewBox="0 0 80 80" fill="none" stroke="#1a1407" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="30" cy="33" r="2.6" fill="#1a1407" stroke="none"/><circle cx="52" cy="33" r="2.6" fill="#1a1407" stroke="none"/><path d="M27 48c3.5 4.6 8 7 13 7s9.5-2.4 13-7"/></svg>
        </span>
      </article>
    </div>

    <div class="pr__guars">
      <div class="guar reveal" data-delay="1">
        <span class="guar__ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M10 9v6M14 9v6"/></svg></span>
        <div><h4 class="guar__title">Pausa cuando quieras</h4><p class="guar__body">¿No tienes pendientes este mes? Pausa tu suscripción y guarda los días que te sobren. Sin broncas.</p></div>
      </div>
      <div class="guar reveal" data-delay="2">
        <span class="guar__ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="m8.5 12 2.5 2.5 4.5-5"/></svg></span>
        <div><h4 class="guar__title">Pruébalo una semana</h4><p class="guar__body">¿No te enamora después de la primera semana? Te regresamos el 75%, sin preguntas.</p></div>
      </div>
    </div>
  </div>
</section>

<style>
  .pr__head { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 1.1rem; margin-bottom: clamp(2.5rem, 5vh, 3.5rem); }
  .pr__eyebrow { display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 600; color: var(--ink-soft); font-size: 1rem; }
  .pr__eyebrow-dot { width: 0.5rem; height: 0.5rem; border-radius: 999px; background: var(--accent); }

  .pr__cards { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(1rem, 2vw, 1.5rem); align-items: stretch; max-width: 1000px; margin-inline: auto; }

  .pr__join {
    background: var(--card); border-radius: var(--r-card-lg);
    padding: clamp(1.75rem, 3vw, 2.5rem);
    display: flex; flex-direction: column; gap: 1rem;
    box-shadow: var(--shadow-card);
    justify-content: space-between;
  }
  .pr__pill { align-self: flex-start; display: inline-flex; align-items: center; gap: 0.45rem; background: var(--ink); color: #fff; font-weight: 600; font-size: 14px; padding: 7px 14px; border-radius: 999px; }
  .pr__pill-dot { width: 0.45rem; height: 0.45rem; border-radius: 999px; background: var(--accent); }
  .pr__joinmark { align-self: center; margin-block: clamp(1.5rem, 4vh, 3rem); width: clamp(76px, 9vw, 104px); }
  .pr__joinmark svg { width: 100%; height: auto; filter: drop-shadow(0 14px 30px rgba(0,0,0,0.18)); }
  .pr__joinfoot { display: flex; flex-direction: column; gap: 0.75rem; }
  .pr__join-title { font-size: clamp(2rem, 1.5rem + 1.4vw, 2.5rem); line-height: 0.96; letter-spacing: -0.04em; }
  .pr__join-sub { color: var(--ink-soft); font-weight: 400; font-size: 16px; max-width: 30ch; }

  .pr__plan {
    position: relative; overflow: hidden;
    background: var(--abyss); color: #fff; border-radius: var(--r-card-lg);
    padding: clamp(1.75rem, 3vw, 2.5rem);
    display: flex; flex-direction: column;
    box-shadow: var(--shadow-lift);
  }
  .pr__planhead { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1.25rem; }
  .pr__planname { font-size: 16px; font-weight: 600; letter-spacing: -0.01em; }
  .pr__badge { background: rgba(255,255,255,0.1); color: #fff; font-weight: 600; font-size: 12px; padding: 5px 10px; border-radius: 999px; }
  .pr__pricerow { display: flex; align-items: baseline; gap: 0.7rem; flex-wrap: wrap; }
  .pr__price { font-size: clamp(2.4rem, 1.8rem + 1.8vw, 2.95rem); letter-spacing: -0.04em; line-height: 0.95; font-weight: 500; font-variant-numeric: tabular-nums; }
  .pr__unit { display: flex; flex-direction: column; }
  .pr__old { color: rgba(255,255,255,0.5); font-weight: 600; font-size: 1.05rem; text-decoration-thickness: 2px; font-variant-numeric: tabular-nums; }
  .pr__per { font-weight: 700; color: rgba(255,255,255,0.7); font-size: 0.92rem; }
  .pr__inc { margin: 1.5rem 0 1rem; font-size: 0.74rem; font-weight: 700; letter-spacing: 0.14em; color: rgba(255,255,255,0.5); }
  .pr__features { list-style: none; padding: 0; margin: 0 0 1.75rem; display: grid; grid-template-columns: 1fr 1fr; gap: 0.85rem 1rem; }
  .pr__features li { display: flex; align-items: center; gap: 0.55rem; font-weight: 500; font-size: 0.98rem; letter-spacing: -0.01em; }
  .pr__features svg { width: 17px; height: 17px; flex-shrink: 0; color: var(--accent); }
  .pr__cta { position: relative; z-index: 1; align-self: flex-start; display: inline-flex; align-items: center; gap: 0.7rem; margin-top: auto; background: rgba(255,255,255,0.08); border: 1px solid var(--line-abyss); border-radius: 12px; padding: 0.55rem 1.2rem 0.55rem 0.55rem; font-weight: 700; font-size: 1.05rem; transition: background-color 0.18s var(--ease-out), transform 0.16s var(--ease-out); }
  .pr__cta:hover { background: rgba(255,255,255,0.14); transform: translateY(-2px); }
  .pr__cta-ic { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 9px; background: var(--accent); color: #fff; }
  .pr__cta-ic svg { width: 30px; height: 30px; }
  .pr__smiley { position: absolute; right: -28px; bottom: -28px; width: 168px; height: 168px; border-radius: 999px 999px 0 999px; background: #f6c14e; display: grid; place-items: center; }
  .pr__smiley svg { width: 84px; height: 84px; transform: translate(-12px,-12px); }
  /* delight: the smile winks when you reach the plan card */
  @media (prefers-reduced-motion: no-preference) {
    .pr__smiley svg circle { transform-box: fill-box; transform-origin: center; }
    .pr__plan:hover .pr__smiley svg circle:first-of-type { animation: ucWink 0.55s var(--ease-out); }
  }

  .pr__guars { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1rem, 2vw, 1.5rem); max-width: 1000px; margin: clamp(1rem, 2vw, 1.5rem) auto 0; }
  .guar { display: flex; gap: 1rem; align-items: flex-start; border: 1px solid var(--line); border-radius: var(--r-card); padding: clamp(1.25rem, 2.4vw, 1.75rem); }
  .guar__ic { flex-shrink: 0; display: grid; place-items: center; width: 38px; height: 38px; color: var(--ink); }
  .guar__title { font-size: 1.2rem; letter-spacing: -0.02em; }
  .guar__body { color: var(--ink-soft); font-weight: 500; font-size: 0.96rem; margin-top: 0.3rem; }

  @media (max-width: 820px) {
    .pr__cards { grid-template-columns: 1fr; }
    .pr__features { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .pr__guars { grid-template-columns: 1fr; }
    .pr__features { grid-template-columns: 1fr; }
  }
</style>
