---
// One drenched "feature" benefit (the speed hook) anchors a bento; the rest float around it.
const items = [
  { mesh: "coral", title: "Entrega rápida", body: "Recibe tu desarrollo uno a la vez, en un par de días hábiles en promedio. Sin filas eternas ni semanas de espera.", icon: "bolt", feature: true },
  { mesh: "amber", title: "Tablero de tareas", body: "Maneja tu cola de desarrollo fácil con un tablero estilo Trello.", icon: "board" },
  { mesh: "lilac", title: "Cuota mensual fija", body: "¡Aquí no hay sorpresas! Pagas el mismo precio fijo cada mes.", icon: "lock" },
  { mesh: "mint", title: "Calidad de primer nivel", body: "Calidad de desarrollo senior a tu alcance, cuando la necesites.", icon: "star" },
  { mesh: "blue", title: "Flexible y escalable", body: "Sube o baja según necesites, y pausa o cancela cuando quieras.", icon: "sliders" },
  { mesh: "iris", title: "Único y todo tuyo", body: "Cada desarrollo es hecho especialmente para ti y es 100% tuyo.", icon: "code" },
];
const icons: Record<string, string> = {
  board: '<rect x="3" y="4" width="18" height="16" rx="2.5"/><path d="M9 4v16M15 4v16"/>',
  lock: '<rect x="5" y="11" width="14" height="9" rx="2.5"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/>',
  bolt: '<path d="M13 3 4 14h7l-1 7 9-11h-7Z"/>',
  star: '<path d="m12 3 2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9 6.8 19.2l1-5.8L3.5 9.2l5.9-.9Z"/>',
  sliders: '<path d="M4 8h10M18 8h2M4 16h2M10 16h10"/><circle cx="16" cy="8" r="2.4"/><circle cx="8" cy="16" r="2.4"/>',
  code: '<path d="m9 8-5 4 5 4M15 8l5 4-5 4"/>',
};
---
<section class="ben section section--air">
  <div class="container">
    <header class="ben__head">
      <h2 class="display-2">Tan bueno que <span class="serif">ya no vas a querer&nbsp;volver</span></h2>
      <p class="lead ben__sub">
        Unlimited Code reemplaza a los freelancers poco confiables y a las agencias caras por una sola
        cuota mensual fija, con desarrollos entregados tan rápido que no vas a querer ir a ningún otro lado.
      </p>
    </header>

    <div class="ben__grid">
      {items.map((it, i) => (
        <article class={`ben__item reveal${it.feature ? " ben__item--feature ben__item--" + it.mesh : ""}`} data-delay={(i % 3) + 1}>
          <span class={`ben__tile ben__tile--${it.mesh}`} aria-hidden="true" set:html={`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">${icons[it.icon]}</svg>`} />
          <h3 class="ben__title">{it.title}</h3>
          <p class="ben__body">{it.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .ben__head { margin-bottom: clamp(2.5rem, 5vh, 3.75rem); text-align: center; }
  .ben__head h2 { max-width: 16ch; margin-inline: auto; }
  .ben__sub { margin-top: 1.25rem; max-width: 52ch; margin-inline: auto; }

  .ben__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: minmax(0, auto);
    gap: clamp(1.75rem, 3vw, 2.75rem) clamp(1.5rem, 2.5vw, 2.5rem);
  }
  .ben__item { display: flex; flex-direction: column; }
  .ben__tile {
    width: clamp(96px, 12vw, 130px); aspect-ratio: 1;
    border-radius: var(--r-tile);
    display: grid; place-items: center;
    color: rgba(255,255,255,0.92);
    margin-bottom: 1.25rem;
    box-shadow: var(--shadow-card);
    transition: transform 0.35s var(--ease-out), box-shadow 0.35s var(--ease-out);
  }
  .ben__tile svg { width: 38%; height: 38%; transition: transform 0.35s var(--ease-out); }
  .ben__item:hover .ben__tile { transform: translateY(-5px) scale(1.04); box-shadow: 0 24px 46px -18px rgba(0,0,0,0.34); }
  .ben__item:hover .ben__tile svg { transform: scale(1.08); }
  @media (prefers-reduced-motion: reduce) {
    .ben__item:hover .ben__tile, .ben__item:hover .ben__tile svg { transform: none; }
  }
  .ben__tile--amber { background: var(--mesh-amber); }
  .ben__tile--lilac { background: var(--mesh-lilac); }
  .ben__tile--coral { background: var(--mesh-coral); }
  .ben__tile--mint { background: var(--mesh-mint); }
  .ben__tile--blue { background: var(--mesh-blue); }
  .ben__tile--iris { background: var(--mesh-iris); }

  .ben__title { font-size: 1.4rem; letter-spacing: -0.025em; }
  .ben__body { margin-top: 0.55rem; color: var(--ink-soft); font-weight: 500; max-width: 34ch; }

  /* Bento feature — drenched 2×2 anchor cell (the speed hook) */
  .ben__item--feature {
    grid-column: span 2; grid-row: span 2;
    justify-content: flex-end;
    border-radius: var(--r-card-lg);
    padding: clamp(1.75rem, 3vw, 2.75rem);
    color: #fff; position: relative; overflow: hidden;
    box-shadow: var(--shadow-card);
    min-height: 300px;
  }
  .ben__item--coral { background: var(--mesh-coral); }
  .ben__item--feature::after {
    content: ""; position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(120% 80% at 18% -10%, rgba(255,255,255,0.28), transparent 55%);
    mix-blend-mode: soft-light;
  }
  .ben__item--feature > * { position: relative; z-index: 1; }
  .ben__item--feature .ben__tile {
    background: rgba(255,255,255,0.18); box-shadow: none;
    width: clamp(60px, 7vw, 78px); border-radius: 16px; margin-bottom: 1.1rem;
  }
  .ben__item--feature .ben__tile svg { width: 44%; height: 44%; color: #fff; }
  .ben__item--feature .ben__title { color: #fff; font-size: clamp(1.7rem, 1.4rem + 1vw, 2.2rem); letter-spacing: -0.035em; text-shadow: 0 1px 10px rgba(0,0,0,0.14); }
  .ben__item--feature .ben__body { color: rgba(255,255,255,0.92); max-width: 34ch; font-size: 1.05rem; font-weight: 450; }
  .ben__item--feature:hover .ben__tile { transform: translateY(-4px); box-shadow: none; }

  @media (max-width: 860px) {
    .ben__grid { grid-template-columns: repeat(2, 1fr); }
    .ben__item--feature { grid-column: span 2; grid-row: span 1; min-height: 0; }
  }
  @media (max-width: 520px) {
    .ben__grid { grid-template-columns: 1fr; }
    .ben__item--feature { grid-column: span 1; }
    .ben__item:not(.ben__item--feature) { align-items: center; text-align: center; }
    .ben__item:not(.ben__item--feature) .ben__body { margin-inline: auto; }
  }
</style>
