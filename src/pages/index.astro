---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import HowItWorks from "../components/HowItWorks.astro";
import StackRow from "../components/StackRow.astro";
import Founder from "../components/Founder.astro";
import Benefits from "../components/Benefits.astro";
import Work from "../components/Work.astro";
import Pricing from "../components/Pricing.astro";
import Faq from "../components/Faq.astro";
import FooterCta from "../components/FooterCta.astro";
---
<Base>
  <main id="contenido">
    <Hero />
    <HowItWorks />
    <StackRow />
    <Founder />
    <Benefits />
    <Work />
    <Pricing />
    <Faq />
  </main>
  <FooterCta />
</Base>

<script>
  // ---- Nav: scrolled state + mobile sheet ----
  const nav = document.querySelector<HTMLElement>("[data-nav]");
  const burger = document.querySelector<HTMLButtonElement>("[data-burger]");

  const onScroll = () => {
    if (!nav) return;
    if (window.scrollY > 8) nav.setAttribute("data-scrolled", "");
    else nav.removeAttribute("data-scrolled");
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  const setMenu = (open: boolean) => {
    if (!nav || !burger) return;
    nav.toggleAttribute("data-open", open);
    burger.setAttribute("aria-expanded", String(open));
    burger.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
  };
  burger?.addEventListener("click", () => setMenu(!nav?.hasAttribute("data-open")));
  document.querySelectorAll("[data-sheet-link]").forEach((a) =>
    a.addEventListener("click", () => setMenu(false))
  );
  window.addEventListener("keydown", (e) => { if (e.key === "Escape") setMenu(false); });
  const mq = window.matchMedia("(min-width: 861px)");
  mq.addEventListener("change", (e) => { if (e.matches) setMenu(false); });

  // ---- Reveal on scroll (enhances an already-visible default) ----
  const reveals = Array.from(document.querySelectorAll<HTMLElement>(".reveal"));
  const revealAll = () => reveals.forEach((el) => el.classList.add("is-in"));

  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (reduce) {
    revealAll();
  } else {
    // Reveal each element the moment its top crosses ~88% of the viewport height — i.e. as it
    // scrolls up into view. rAF-throttled, cheap reads only. Reliable (no IntersectionObserver).
    let ticking = false;
    const check = () => {
      ticking = false;
      const trigger = window.innerHeight * 1.1;
      for (let i = reveals.length - 1; i >= 0; i--) {
        const el = reveals[i];
        if (el.getBoundingClientRect().top < trigger) {
          el.classList.add("is-in");
          reveals.splice(i, 1);
        }
      }
    };
    const onScrollReveal = () => {
      if (!ticking) { ticking = true; requestAnimationFrame(check); }
    };
    window.addEventListener("scroll", onScrollReveal, { passive: true });
    window.addEventListener("resize", onScrollReveal, { passive: true });
    check();
  }
</script>
