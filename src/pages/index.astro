---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import HowItWorks from "../components/HowItWorks.astro";
import StackRow from "../components/StackRow.astro";
import Founder from "../components/Founder.astro";
import Benefits from "../components/Benefits.astro";
import Work from "../components/Work.astro";
import Pricing from "../components/Pricing.astro";
import Faq from "../components/Faq.astro";
import FooterCta from "../components/FooterCta.astro";
---
<Base>
  <main id="contenido">
    <Hero />
    <HowItWorks />
    <StackRow />
    <Founder />
    <Benefits />
    <Work />
    <Pricing />
    <Faq />
  </main>
  <FooterCta />

  <!-- Mobile-only sticky CTA: thumb-zone shortcut to pricing (nav buttons are hidden ≤479px) -->
  <a class="mcta" href="#precios" data-mcta>
    Ver precios
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
  </a>
</Base>

<style is:global>
  .mcta {
    position: fixed; z-index: 150;
    left: 50%; bottom: max(1rem, env(safe-area-inset-bottom));
    transform: translate(-50%, 160%);
    display: none; align-items: center; gap: 0.5rem;
    background: var(--accent); color: #fff;
    font-weight: 700; font-size: 16px; letter-spacing: -0.01em;
    padding: 13px 22px; border-radius: 999px;
    box-shadow: 0 14px 30px -10px rgba(255, 90, 0, 0.55), 0 4px 10px -4px rgba(0,0,0,0.3);
    transition: transform 0.5s var(--ease-out);
    will-change: transform;
  }
  .mcta svg { width: 18px; height: 18px; }
  .mcta.is-on { transform: translate(-50%, 0); }
  .mcta:active { transform: translate(-50%, 0) scale(0.96); }
  @media (max-width: 600px) { .mcta { display: inline-flex; } }
  @media (prefers-reduced-motion: reduce) { .mcta { transition: none; } }
</style>

<script>
  // ---- Nav: scrolled state + mobile sheet ----
  const nav = document.querySelector<HTMLElement>("[data-nav]");
  const burger = document.querySelector<HTMLButtonElement>("[data-burger]");

  const onScroll = () => {
    if (!nav) return;
    if (window.scrollY > 8) nav.setAttribute("data-scrolled", "");
    else nav.removeAttribute("data-scrolled");
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  const setMenu = (open: boolean) => {
    if (!nav || !burger) return;
    nav.toggleAttribute("data-open", open);
    burger.setAttribute("aria-expanded", String(open));
    burger.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
  };
  burger?.addEventListener("click", () => setMenu(!nav?.hasAttribute("data-open")));
  document.querySelectorAll("[data-sheet-link]").forEach((a) =>
    a.addEventListener("click", () => setMenu(false))
  );
  window.addEventListener("keydown", (e) => { if (e.key === "Escape") setMenu(false); });
  const mq = window.matchMedia("(min-width: 861px)");
  mq.addEventListener("change", (e) => { if (e.matches) setMenu(false); });

  // ---- Reveal on scroll (enhances an already-visible default) ----
  const reveals = Array.from(document.querySelectorAll<HTMLElement>(".reveal"));
  const revealAll = () => reveals.forEach((el) => el.classList.add("is-in"));

  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (reduce) {
    revealAll();
  } else {
    // Reveal each element the moment its top crosses ~88% of the viewport height — i.e. as it
    // scrolls up into view. rAF-throttled, cheap reads only. Reliable (no IntersectionObserver).
    let ticking = false;
    const check = () => {
      ticking = false;
      const trigger = window.innerHeight * 1.1;
      for (let i = reveals.length - 1; i >= 0; i--) {
        const el = reveals[i];
        if (el.getBoundingClientRect().top < trigger) {
          el.classList.add("is-in");
          reveals.splice(i, 1);
        }
      }
    };
    const onScrollReveal = () => {
      if (!ticking) { ticking = true; requestAnimationFrame(check); }
    };
    window.addEventListener("scroll", onScrollReveal, { passive: true });
    window.addEventListener("resize", onScrollReveal, { passive: true });
    check();
  }

  // ---- Mobile sticky CTA: show after the hero, hide once pricing is on screen ----
  const mcta = document.querySelector<HTMLElement>("[data-mcta]");
  if (mcta) {
    const precios = document.querySelector<HTMLElement>("#precios");
    let mTick = false;
    const updateMcta = () => {
      mTick = false;
      const pastHero = window.scrollY > window.innerHeight * 0.75;
      const preciosShown = precios ? precios.getBoundingClientRect().top < window.innerHeight * 0.85 : false;
      mcta.classList.toggle("is-on", pastHero && !preciosShown);
    };
    const onMcta = () => { if (!mTick) { mTick = true; requestAnimationFrame(updateMcta); } };
    window.addEventListener("scroll", onMcta, { passive: true });
    window.addEventListener("resize", onMcta, { passive: true });
    updateMcta();
  }

  // ---- Confetti: the brand smiley bursts confetti on click (no email, just joy) ----
  const COLORS = ["#ff5a00", "#ff3db0", "#c14bff", "#2440ff", "#f6c14e", "#2fe39a"];
  function confettiBurst(x: number, y: number) {
    if (reduce) return;
    const canvas = document.createElement("canvas");
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.style.cssText = "position:fixed;inset:0;width:100vw;height:100vh;pointer-events:none;z-index:9999";
    canvas.width = innerWidth * dpr; canvas.height = innerHeight * dpr;
    document.body.appendChild(canvas);
    const ctx = canvas.getContext("2d")!;
    ctx.scale(dpr, dpr);
    const N = 90;
    const parts = Array.from({ length: N }, (_, i) => {
      const ang = (Math.PI * 2 * i) / N + (i % 7) * 0.13;
      const sp = 5 + (i % 11);
      return {
        x, y,
        vx: Math.cos(ang) * sp * (0.5 + (i % 5) / 5),
        vy: Math.sin(ang) * sp - 6,
        s: 5 + (i % 6),
        rot: i, vr: (i % 2 ? 1 : -1) * (0.2 + (i % 5) / 12),
        c: COLORS[i % COLORS.length],
        life: 1,
      };
    });
    let raf = 0; const t0 = performance.now();
    const tick = (t: number) => {
      const dt = Math.min((t - t0) / 1000, 2);
      ctx.clearRect(0, 0, innerWidth, innerHeight);
      let alive = false;
      for (const p of parts) {
        p.vy += 0.32; p.vx *= 0.99; p.x += p.vx; p.y += p.vy; p.rot += p.vr;
        p.life = Math.max(0, 1 - dt / 1.5);
        if (p.life > 0 && p.y < innerHeight + 40) {
          alive = true;
          ctx.save(); ctx.globalAlpha = p.life;
          ctx.translate(p.x, p.y); ctx.rotate(p.rot);
          ctx.fillStyle = p.c; ctx.fillRect(-p.s / 2, -p.s / 2, p.s, p.s * 0.6);
          ctx.restore();
        }
      }
      if (alive) raf = requestAnimationFrame(tick);
      else { cancelAnimationFrame(raf); canvas.remove(); }
    };
    raf = requestAnimationFrame(tick);
  }
  document.querySelectorAll<HTMLElement>("[data-confetti]").forEach((el) => {
    el.addEventListener("click", (e) => {
      e.preventDefault();
      e.stopPropagation();
      const me = e as MouseEvent;
      const r = el.getBoundingClientRect();
      const x = me.clientX || r.left + r.width / 2;
      const y = me.clientY || r.top + r.height / 2;
      confettiBurst(x, y);
    });
  });
</script>
